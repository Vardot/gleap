{#
/**
 * @file
 * Gleap block template.
 *
 * Available variables:
 * - show_message: Boolean flag indicating if a message should be displayed.
 * - message: The message to display (only when show_message is true).
 */
#}

{% if show_message and message %}
  <div class="gleap-message">
    {{ message }}
  </div>
{% endif %}